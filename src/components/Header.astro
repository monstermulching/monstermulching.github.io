---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { business } from '../data/business';

const nav = [
  { href: '/#services', label: 'Services' },
  { href: '/#equipment', label: 'Equipment' },
  { href: '/#about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-night/90 backdrop-blur">
  <div class="wrap flex items-center justify-between gap-4 py-2">
    <a href="/" aria-label="Monster Mulching home" class="shrink-0">
      <Image src={logo} alt="Monster Mulching" width={120} densities={[1, 2]} loading="eager" class="h-12 w-auto sm:h-14" />
    </a>

    <nav aria-label="Main" class="flex items-center gap-2 sm:gap-8">
      <ul class="hidden items-center gap-8 font-display text-lg font-semibold uppercase tracking-[0.1em] md:flex">
        {nav.map((item) => (
          <li><a href={item.href} class="text-moss transition-colors hover:text-slime">{item.label}</a></li>
        ))}
      </ul>
      <a href={`tel:${business.phoneE164}`} class="btn btn-primary px-4 py-2 text-base">
        <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg>
        <span class="hidden sm:inline">{business.phone}</span>
        <span class="sm:hidden">Call</span>
      </a>
    </nav>
  </div>
</header>
