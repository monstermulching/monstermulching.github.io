---
import Drips from './Drips.astro';
interface Props { kicker: string; title: string }
const { kicker, title } = Astro.props;
---
<section>
  <div class="bg-slime text-night">
    <div class="wrap py-14 sm:py-20">
      <p class="font-display text-base font-semibold uppercase tracking-[0.18em] text-night/70">{kicker}</p>
      <h1 class="mt-3 !text-night">{title}</h1>
    </div>
  </div>
  <Drips />
</section>
