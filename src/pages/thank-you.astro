---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
---
<Base
  title="Thank You - Monster Mulching"
  description="Thank you for contacting Monster Mulching. We have received your message and will get back to you soon."
  noindex
>
  <PageIntro kicker="Message received" title="Thank you!" />
  <section class="section pt-10">
    <div class="wrap max-w-[68ch]">
      <p class="text-lg text-moss">
        We've received your message and appreciate you reaching out. Our team will review your enquiry and get back to you as soon as possible, typically within 1-2 business days.
      </p>
      <a href="/" class="btn btn-primary mt-8">Return to home</a>
    </div>
  </section>
</Base>
